rules_version = '2';

// Every path below used to allow ANY authenticated user to write a file of ANY size and ANY
// content type into their own folder — no limit at all. That means (a) a denial-of-wallet risk
// (someone uploading huge files repeatedly to run up Storage/bandwidth costs), and (b) Astryks's
// own bucket could be used to publicly host arbitrary non-media content (HTML/JS, etc.) that has
// nothing to do with the app, since read access is public. Each match below now caps size and
// restricts content-type to what that folder is actually for.
service firebase.storage {
  match /b/{bucket}/o {
    // True if the given post exists AND is either explicitly marked private OR auto-flagged by
    // moderatePostMedia (functions/index.js) — used below to gate reads of post media uploaded
    // after the postId-in-path change. Checks existence first: a bare firestore.get() on a
    // postId that doesn't exist yet (the brief window between an upload finishing and its
    // Firestore doc write completing) would otherwise fail the whole rule instead of just this
    // condition, same reasoning as the "resource == null ||" guards in firestore.rules.
    // Previously this only checked `visibility == 'private'` — a flagged-but-nominally-public
    // post's media stayed fetchable by anyone with its Storage path (or an old mediaUrl) even
    // though Firestore itself already hides the post document for exactly this reason.
    function postIsHidden(postId) {
      return firestore.exists(/databases/(default)/documents/posts/$(postId))
        && (firestore.get(/databases/(default)/documents/posts/$(postId)).data.visibility == 'private'
          || firestore.get(/databases/(default)/documents/posts/$(postId)).data.moderationStatus == 'flagged');
    }

    // Post media uploaded after the private-post-media fix: the path now includes the post's
    // own Firestore doc ID (see ShareComposer.tsx/home.tsx), so unlike the legacy flat layout
    // below, this one can actually check whether that specific post is private/flagged before
    // serving the file. The post's own owner or an admin can still always read it.
    match /posts/{userId}/{postId}/{fileName} {
      allow read: if (request.auth != null && (
            request.auth.uid == userId ||
            (request.auth.token.admin == true || (request.auth.token.email in ['mehta.siddharth09@gmail.com'] && request.auth.token.email_verified == true))
          )) || !postIsHidden(postId);
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
    }

    // Legacy flat path, from before post media carried the post's own ID above — reads stay
    // public since Storage has no way to look up which post one of these files belongs to, so a
    // still-public legacy post's visibility can't be checked here (see postIsHidden above,
    // which needs a postId). Every client (ShareComposer.tsx/home.tsx/me.tsx, web + mobile)
    // already writes to the postId-scoped layout above instead, and both
    // migratePrivatePostMedia (bulk) and securePostMediaOnHide (per-post, on every write) in
    // functions/index.js move any post that goes private/flagged off this layout automatically
    // — so nothing legitimate should ever write here again. Denying writes closes off the flat
    // layout as an evasion route (e.g. a client that deliberately omits postId from the path to
    // dodge postIsHidden) rather than just relying on nobody doing that.
    match /posts/{userId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
